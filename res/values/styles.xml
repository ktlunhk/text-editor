<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Holo.Light.DarkActionBar">
        <item name="android:actionBarStyle">@style/MyActionBar</item>
    </style>

    <style name="AppTheme.Dark" parent="android:Theme.Holo">
        <item name="android:actionBarStyle">@style/MyActionBarDark</item>
    </style>

    <style name="MyActionBar" parent="android:Widget.Holo.Light.ActionBar.Solid.Inverse">
        <item name="android:background">#3F51B5</item>
    </style>

    <style name="MyActionBarDark" parent="android:Widget.Holo.ActionBar.Solid">
        <item name="android:background">#212121</item>
    </style>
</resources>
